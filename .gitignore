# .gitignore lists files and folders that Git should NOT track.
# Each line is a pattern: a name ending in / matches a folder, * matches any
# characters, and a line starting with ! makes an exception to an earlier rule.
# We ignore anything that is generated (you can recreate it), large, private
# to your machine, or secret. Anyone who clones the repository recreates
# these files from the code and requirements.txt.
# Reference: https://git-scm.com/docs/gitignore

# The virtual environment. It holds hundreds of MB of installed packages
# and is rebuilt from requirements.txt with `make venv`.
.venv/
# Compiled bytecode that Python writes automatically when it imports a
# module, plus pytest's cache. All of it is regenerated on the next run.
__pycache__/
*.pyc
.pytest_cache/
# Personal editor settings for VS Code; each developer has their own.
.vscode/

# ---- ML artifacts ----
# Trained model files are generated by the training scripts. The second
# line is an exception: keep the empty models/.gitkeep file in Git so the
# models/ folder exists in a fresh clone.
# To share a model, track it with DVC (`dvc add models/<file>.pkl`); Git
# then stores only the small <file>.pkl.dvc pointer file.
models/*.pkl
!models/.gitkeep

# ---- Data ----
# Processed data is generated from the raw CSV by `make preprocess`.
data/processed/

# ---- Experiment tracking (MLflow) ----
# MLflow's local tracking database (SQLite) and its folder of saved run
# artifacts. They are generated on every run and grow quickly.
mlflow.db
mlruns/

# ---- Data versioning (DVC) ----
# DVC's local cache and temporary files are large and machine-specific.
# .dvc/config.local holds your DagsHub access keys (written by
# `dvc remote modify --local`). It must never be committed, because anyone
# who can read the repository could then use your credentials.
.dvc/cache/
.dvc/tmp/
.dvc/config.local
